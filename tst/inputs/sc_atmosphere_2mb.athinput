<comment>
problem = nr_radiation SC Eq. 30 Jacobi-ALI with 2 MeshBlocks (bb+ir ghost exchange)
# Same physics as sc_atmosphere; require_analytic=false — pass on ALI convergence.
# Compare sumJ_dx to 1-block run in smoke_sc_tests.py

<job>
basename = ut_sc_atmosphere_2mb

<mesh>
nghost = 2
nx1    = 128
x1min  = 0.0
x1max  = 1.0
ix1_bc = inflow
ox1_bc = inflow
nx2    = 1
x2min  = -0.5
x2max  = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3    = 1
x3min  = -0.5
x3max  = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 64
nx2 = 1
nx3 = 1

<time>
evolution  = static
integrator = rk2
cfl_number = 0.3
nlim       = 0
tlim       = 0.0

<nr_radiation>
nmu          = 3
opa          = 40.0
ops          = 0.0
eps          = 1.0e-2
prat         = 1.0
crat         = 1.0
affect_fluid = false
sweep        = wavefront
iter_max     = 5000
itermin      = 2
ali_tol      = 1.0e-6
ali_omega    = 1.0          # ALI over-relaxation (SOR); 1.0 = standard Jacobi-ALI; range (0,2)
ali_mode     = jacobi       # jacobi (default) | gauss_seidel (center-out fused GS, wavefront)
gs_scatter   = false        # GS local-scatter acceleration (Option B); false = bit-identical
gs_scatter_mode = normalized # normalized (default, stable) | geometric (implicitly over-relaxed)

<problem>
pgen_name = sc_atmosphere
chi    = 40.0
source = 1.0
tol    = 8.0e-2
require_analytic = false
max_ali_iters = 5000
