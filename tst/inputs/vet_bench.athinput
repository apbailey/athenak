<comment>
problem = VET short-characteristics sweep throughput benchmark

# Times VET::FormalSolution() on a uniform medium (I == b steady state).
# Sweep-kernel throughput only; no boundary exchange. Vary block count via <meshblock>,
# angle count via <nr_radiation>/nmu. evolution=static + nlim=0 so timing is in the pgen.

<job>
basename = vet_bench

<mesh>
nghost = 2
nx1    = 64
x1min  = 0.0
x1max  = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2    = 64
x2min  = 0.0
x2max  = 1.0
ix2_bc = outflow
ox2_bc = outflow
nx3    = 64
x3min  = 0.0
x3max  = 1.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<time>
evolution  = static
integrator = rk2
cfl_number = 0.3
nlim       = 0
tlim       = 0.0

<nr_radiation>
nmu          = 3
opa          = 1.0
prat         = 1.0
crat         = 1.0
affect_fluid = false
sweep        = wavefront

<problem>
pgen_name = vet_bench
chi     = 1.0
source  = 1.0
nbench  = 20
