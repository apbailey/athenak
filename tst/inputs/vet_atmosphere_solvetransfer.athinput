<comment>
problem = nr_radiation VET Eq. 30 via production SolveTransfer (1 cycle)
# Pgen only sets ICs; ALI runs in before_timeintegrator SolveTransfer
# No hydro: nofluid opacity path preserves pgen planck/bb

<job>
basename = ut_vet_atmosphere_st

<mesh>
nghost = 2
nx1    = 128
x1min  = 0.0
x1max  = 1.0
ix1_bc = inflow
ox1_bc = inflow
nx2    = 1
x2min  = -0.5
x2max  = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3    = 1
x3min  = -0.5
x3max  = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 128
nx2 = 1
nx3 = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 1
tlim       = 1.0e10

<nr_radiation>
nmu          = 3
opa          = 40.0
ops          = 0.0
eps          = 1.0e-2
prat         = 1.0
crat         = 1.0
affect_fluid = false
sweep        = wavefront
iter_max     = 5000
itermin      = 2
ali_tol      = 1.0e-6

<problem>
pgen_name = vet_atmosphere
chi    = 40.0
source = 1.0
tol    = 8.0e-2
use_solve_transfer = true
require_analytic = false
max_ali_iters = 5000
