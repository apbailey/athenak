<comment>
problem = nr_radiation SC 3D uniform radiative-equilibrium unit test

# 3D uniform medium: constant absorption chi, constant source S = b everywhere, intensity
# initialized to b. One FormalSolution sweep must leave I == b to machine precision.

<job>
basename = ut_sc_uniform

<mesh>
nghost = 2
nx1    = 16
x1min  = 0.0
x1max  = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2    = 16
x2min  = 0.0
x2max  = 1.0
ix2_bc = outflow
ox2_bc = outflow
nx3    = 16
x3min  = 0.0
x3max  = 1.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution  = static
integrator = rk2
cfl_number = 0.3
nlim       = 0
tlim       = 0.0

<nr_radiation>
nmu          = 3
opa          = 1.0
prat         = 1.0
crat         = 1.0
affect_fluid = false
sweep        = wavefront

<problem>
pgen_name = sc_uniform
chi    = 5.0
source = 1.0
tol    = 1.0e-12
