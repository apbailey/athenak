<comment>
problem  = SC sweep determinism / race probe (generic pgen; sweep chosen in <nr_radiation>)
# Variant of sc_determinism_wavefront.athinput with <nr_radiation>/sc_hoist = true (ledger I3:
# per-ray precomputed interpolation invariants). Must PASS determinism AND hash-match the baseline
# wavefront (sc_hoist=false) bit-for-bit -- the I3 correctness gate (test_sc_hoist_matches_baseline).

<job>
basename = ut_sc_determinism_hoist_wavefront

<mesh>
nghost = 2
nx1    = 32
x1min  = 0.0
x1max  = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2    = 32
x2min  = 0.0
x2max  = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3    = 32
x3min  = 0.0
x3max  = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32          # one 32^3 block (matches sc_sphere: fast teardown); ~1.5M threads still races

<time>
evolution  = static
integrator = rk2
cfl_number = 0.3
nlim       = 0    # no driver cycles; the pgen runs the determinism loop itself
tlim       = 0.0

<nr_radiation>
nmu          = 3        # nang_tot = 48 (3D Carlson) -> ~12.6M sweep threads at 64^3
opa          = 0.5      # nonzero so edtau<1 and the upwind intensity actually contributes
ops          = 0.0      # ops=0 & eps=1 -> use_ali=false: pure-transport probe (Lambda* is race-free anyway)
eps          = 1.0
prat         = 1.0
crat         = 1.0
affect_fluid = false
sweep        = wavefront       # sanity: ordered sweep must be deterministic
sc_hoist     = true            # ledger I3: precomputed per-ray invariants (must match sc_hoist=false)
iter_max     = 1
itermin      = 1

<problem>
pgen_name = sc_sweep_determinism
chi0      = 0.5         # uniform opacity set by the pgen (overrides opa for the field)
ir_bg     = 1.0         # background intensity / source level
amp       = 1.0         # gradient amplitude (0 => uniform => trivial pass; >0 => race observable)
axis      = 1           # gradient axis (1/2/3)
rough     = true        # deterministic hash field (non-smooth, stronger race stressor) vs smooth ramp
nrepeat   = 64          # relaunches from the frozen input; all outputs must hash-match
test_exchange = false   # if true: run only the boundary-exchange bridge round-trip check
