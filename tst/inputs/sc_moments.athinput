<comment>
problem = nr_radiation SC angular-moment unit test

# 3D so all moment components (H_i, K_ij) are exercised. Sets I = 1 + mu_x and checks
# J=1, H=(1/3,0,0), K_ii=1/3, K_ij=0 against the quadrature identities.

<job>
basename = ut_sc_moments

<mesh>
nghost = 2
nx1    = 8
x1min  = 0.0
x1max  = 1.0
ix1_bc = outflow
ox1_bc = outflow
nx2    = 8
x2min  = 0.0
x2max  = 1.0
ix2_bc = outflow
ox2_bc = outflow
nx3    = 8
x3min  = 0.0
x3max  = 1.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<time>
evolution  = static
integrator = rk2
cfl_number = 0.3
nlim       = 0
tlim       = 0.0

<nr_radiation>
nmu          = 2
opa          = 1.0
prat         = 1.0
crat         = 1.0
affect_fluid = false
sweep        = wavefront

<problem>
pgen_name = sc_moments
tol       = 1.0e-12
