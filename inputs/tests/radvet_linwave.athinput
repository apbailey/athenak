# AthenaK input: LTE SC damped acoustic wave (Athena-C athinput.linear_wave_rad2d)

<comment>
problem   = radvet linwave
reference = Davis, Stone & Jiang 2012 Eq. 38

<job>
basename  = RadvetLinWave

<mesh>
nghost    = 2
nx1       = 64
x1min     = 0.0
x1max     = 2.2360680
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 32
x2min     = 0.0
x2max     = 1.1180399
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 8
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 1.0
ndiag      = 10

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.66666666667

<radiation_vet>
nmu         = 2
chi_type    = constant
# chi0 = tau * 2π  (lambda=1 for this box geometry)
chi0        = 6.28318530718
bb_type     = greybody
# bb_norm = B0/T0^4 with T0=1/gamma, B0=gamma*E0/(Bo*pi), E0=1/(gamma*gm1)
bb_norm     = 3.6838585
affect_fluid = true
iter_max    = 20
iter_tol    = 1.0e-10

<problem>
pgen_name = radvet_linwave
amp       = 1.0e-6
vflow     = 0.0
Bo        = 1.0
tau       = 1.0

<output1>
file_type = hst
dt        = 0.1
