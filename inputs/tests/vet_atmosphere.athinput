<comment>
problem = nr_radiation VET non-LTE atmosphere (Davis 2012 Eq. 30) Jacobi-ALI test
# Semi-infinite: vacuum at τ=0 (ix1 inflow I=0), thermalized deep end (ox1 inflow I=B)

<job>
basename = ut_vet_atmosphere

<mesh>
nghost = 2
nx1    = 128
x1min  = 0.0
x1max  = 1.0
ix1_bc = inflow
ox1_bc = inflow
nx2    = 1
x2min  = -0.5
x2max  = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3    = 1
x3min  = -0.5
x3max  = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 128
nx2 = 1
nx3 = 1

<time>
evolution  = static
integrator = rk2
cfl_number = 0.3
nlim       = 0
tlim       = 0.0

<nr_radiation>
nmu          = 3
opa          = 40.0
ops          = 0.0
eps          = 1.0e-2
prat         = 1.0
crat         = 1.0
affect_fluid = false
sweep        = wavefront
iter_max     = 5000
itermin      = 2
ali_tol      = 1.0e-6

<problem>
pgen_name = vet_atmosphere
chi    = 40.0
source = 1.0
tol    = 8.0e-2
max_ali_iters = 5000
