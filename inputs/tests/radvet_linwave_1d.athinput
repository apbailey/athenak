# AthenaK input: Davis et al. 2012 §5.4 radiating linear waves (1D)
# Matches Athena-C athinput.linear_wave_rad1d / Figs. 9–10.
# chi0 and bb_norm are set from Bo, tau inside the pgen.

<comment>
problem   = radvet linwave 1D Davis §5.4
reference = Davis, Stone & Jiang 2012 Figs. 9–10

<job>
basename  = RadvetLinWave1D

<mesh>
nghost    = 2
nx1       = 256
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 1
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 256
nx2       = 1
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 1.0
ndiag      = 100

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = llf
gamma       = 1.6666666666666667

<radiation_vet>
nmu         = 4
chi_type    = constant
# overridden from Bo,tau in pgen; placeholders required by ctor
chi0        = 6.28318530718
bb_type     = greybody
bb_norm     = 3.6838585
affect_fluid = true
iter_max    = 20
iter_tol    = 1.0e-10

<problem>
pgen_name = radvet_linwave
amp       = 1.0e-6
vflow     = 0.0
Bo        = 1.0
tau       = 1.0

<output1>
file_type = hst
dt        = 0.1
